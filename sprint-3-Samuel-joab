void cadastrarUsuario(Usuario usuarios[], int *total)
{
    char matriculaValida[13]; // variavel para validar a matricula   
    int isAEmail = 0; // variavel para auxiliar na validacao do email
    puts("digite o nome a cadastrar");

    fgets(usuarios[*total].nome, 81, stdin);

    usuarios[*total].nome[strcspn(usuarios[*total].nome, "\n")] = '\0';
    do
    {

        puts("digite a matricula a cadastrar");

        fgets(matriculaValida, 13, stdin);

        matriculaValida[strcspn(matriculaValida, "\n")] = '\0';
        if (strlen(matriculaValida) < 8 || strlen(matriculaValida) > 12)
        {
            puts("a matricula deve conter entre 8 e 12 caracteres");
        }
        if(buscarUsuario(usuarios, *total, matriculaValida) != -1)
        {
            puts("ja existe um usuario cadastrado com essa matricula, digite outra");
        }

    } while (strlen(matriculaValida) < 8 || strlen(matriculaValida) > 12);
    strcpy(usuarios[*total].matricula, matriculaValida);
    do
    {

        puts("digite o email do usuario");

        fgets(usuarios[*total].email, 101, stdin);

        usuarios[*total].email[strcspn(usuarios[*total].email, "\n")] = '\0';

        if (strchr(usuarios[*total].email, '@') != NULL && strchr(usuarios[*total].email, '.') != NULL)
        {
            isAEmail = 1;
        }
        else
        {
            puts("digite um email valido");
        }
    } while (isAEmail != 1);

    puts("usuario cadastrado");

    (*total)++;
}
// utiliza as funcoes de buscar livro e usuario para validar se existem, depois disso modifica os campos do emprestimo e do livro, alem de incrementar o historico de acessos
void realizarEmprestimo(Livro acervo[], int nl, Usuario usuarios[], int nu, Emprestimo emprestimos[], int *ne, int historico[][20])
{
    int indiceLivro = -1, indiceUsuario = -1;
    char mat[13], isbn[14];
    int c;
    printf("digite a matricula do usuario:\n");
    scanf("%s", mat);
    while ((c = getchar()) != '\n' && c != EOF)
        ;

    indiceUsuario = buscarUsuario(usuarios, nu, mat); // usei a func que ja tinha criado para verifificar se o usuario existe
    if (indiceUsuario == -1)
    {
        printf("usuario nao encontrado\n");
        return;
    }
    printf("digite o ISBN do livro:\n");
    scanf("%s", isbn);
    while ((c = getchar()) != '\n' && c != EOF)
        ;
    indiceLivro = buscarPorISBN(acervo, nl, isbn);
    if (indiceLivro == -1)
    {
        printf("livro nao encontrado\n");
        return;
    }
    if (acervo[indiceLivro].disponivel == 0)
    {
        printf("livro indisponivel\n");
        return;
    }
    do
    {
        puts("digite a data");
        scanf("%s", emprestimos[*ne].data);
        while ((c = getchar()) != '\n' && c != EOF)
            ;
        if (validarData(emprestimos[*ne].data) == 0)
        {
            puts("data invalida,ela deve estar no formato dd/mm/aaaa");
        }
    } while (validarData(emprestimos[*ne].data) == 0);
    strcpy(emprestimos[*ne].isbn, isbn);
    strcpy(emprestimos[*ne].matricula, mat);
    historico[indiceUsuario][indiceLivro]++;
    acervo[indiceLivro].quantidade--;
    if (acervo[indiceLivro].quantidade == 0)
    {
        acervo[indiceLivro].disponivel = 0;
    }
    emprestimos[*ne].devolvido = 0;
    printf("codigo do emprestimo: %d\n guarde bem,sera usado para devolucao\n", *ne);
    (*ne)++;
}

// ao pesquisar,descobri que a biblioteca ctype tem metodos para validar o tipo de um caracter

int validarData(char data[])
{
    if (strlen(data) != 10)
        return 0;

    if (data[2] != '/' || data[5] != '/')
        return 0;

    for (int i = 0; i < 10; i++)
    {
        if (i == 2 || i == 5)
            continue;

        if (!isdigit(data[i]))
            return 0;
    }

    return 1;
}

// basicamente,reutiilizo as funções de buscar livro e usuario para validar se existem,depois disso modifico os campos do emprestimo
void registrarDevolucao(Usuario usuarios[], int nu, Livro acervo[], int nl, Emprestimo emprestimos[], int *ne, int historico[][20])
{
    char mat[13], isbn[14];
