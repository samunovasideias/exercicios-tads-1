    }
    else
    {
        acervo[indiceLivro].disponivel = 0;
    }
}

int buscarUsuario(Usuario usuarios[], int nu, char *matricula)
{
    for (int i = 0; i < nu; i++)
    {
        if (strcmp(matricula, usuarios[i].matricula) == 0)
        {
            return i;
        }
    }
    return -1; // retornado quando nao encontrar nennhum usuario
}

