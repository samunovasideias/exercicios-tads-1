// usa ponteiros para modificar as variaveis da main
// nessa,na func de cad de livro e de emprestimos,eu reutilizei metodos,como o buscar isbn e  buscar usuario,
// tirando isso,usei a biblioteca ctype para validar o tipo de caracter do isbn e do email, alem de usar loops para validar o tamanho da matricula e do isbn
// eu poderia dar um return seco,mas preferi deixar intuitivo com o do-while,assim o usuario nao precisa redigitar tudo
//
void cadastrarLivro(Livro acervo[], int *total)
{
    int isIsbnValid = 0; // uso para validar o isbn
    int c;
    char isbn[14]; // isbn digitado pelo usuario,uso para validar o isbn antes de copiar para o acervo

    printf("digite o nome do livro:\n");

    fgets(acervo[*total].titulo, 101, stdin);

    acervo[*total].titulo[strcspn(acervo[*total].titulo, "\n")] = '\0';

    printf("digite o autor do livro:\n");

    fgets(acervo[*total].autor, 81, stdin);

    acervo[*total].autor[strcspn(acervo[*total].autor, "\n")] = '\0';

    printf("digite o ano do livro:\n");

    scanf("%d", &acervo[*total].ano);

    while ((c = getchar()) != '\n' && c != EOF)
        ;

    printf("digite a quantidade  de livros:\n");

    scanf("%d", &acervo[*total].quantidade);

    while ((c = getchar()) != '\n' && c != EOF)
        ;
    do
    {

        printf("digite o ISBN:\n");

        fgets(isbn, 14, stdin);
        isbn[strcspn(isbn, "\n")] = '\0';
        if (strlen(isbn) != 13)
        {
            printf("o ISBN deve ter 13 digitos\ndigite novamente:\n");
            isIsbnValid = 0;
            continue;
        }
        for (int i = 0; i < 13; i++)
        {
            if (!isdigit(isbn[i]))
            {
                printf("o ISBN deve conter apenas numeros\ndigite novamente:\n");
                isIsbnValid = 0;
                continue;
            }
        }
        if (buscarPorISBN(acervo, *total, isbn) != -1)
        {
            printf("ja existe um livro cadastrado com esse ISBN\ndigite novamente:\n");
            isIsbnValid = 0;
            continue;
        }
        isIsbnValid = 1;

    } while (isIsbnValid != 1);
    strcpy(acervo[*total].isbn, isbn);

    if (acervo[*total].quantidade > 0)
    {
        acervo[*total].disponivel = 1;
    }
    else
    {
        acervo[*total].disponivel = 0;
    }

    (*total)++;
}

