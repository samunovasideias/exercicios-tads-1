int buscarPorISBN(Livro acervo[], int total, char *isbn)
{
    for (int i = 0; i < total; i++)
    {
        if (!strcmp(isbn, acervo[i].isbn))
        {
            return i;
        }
    }
    return -1; // retornado quando nao encontrar nennhum livro
}

