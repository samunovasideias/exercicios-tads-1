// usa uma sequencia de loops para verificar se o termo digitado esta em algum livro
//minha funcao favorita 
void buscarTitulo(Livro acervo[], int total)
{

    char nomeBuscar[101];

    printf("digite o nome:\n");

    fgets(nomeBuscar, 101, stdin);

    nomeBuscar[strcspn(nomeBuscar, "\n")] = '\0';

    printf("................buscando...............\n");

    int encontrados = 0;

    for (int i = 0; i < total; i++)
    {

        int encontrou = 0;

        for (int j = 0; acervo[i].titulo[j] != '\0'; j++)
        {

            int k = 0;

            while (nomeBuscar[k] != '\0' && acervo[i].titulo[j] == nomeBuscar[k])
            {

                k++;
            }

            if (nomeBuscar[k] == '\0')
            {

                encontrou = 1;
                break;
            }
        }

        if (encontrou)
        {

            printf("livro:\ntitulo: %s\nautor: %s\nano de publicacao: %d\n %s\n ISBN:%s\n=========================================\n ",
                   acervo[i].titulo, acervo[i].autor, acervo[i].ano, acervo[i].disponivel == 1 ? "disponivel" : "indisponivel", acervo[i].isbn);

            encontrados++;
        }
    }

    printf("foram encontrados %d titulos \n=========================================\n", encontrados);
}

// lista os livros disponiveis comparando a variavel "disponivel"
void livrosDisponiveis(Livro acervo[], int total)
{

    printf("DISPONIVEIS:\n");

    int contador = 0;

    for (int i = 0; i < total; i++)
    {

        if (acervo[i].disponivel == 1)
        {

            printf("livro:\ntitulo: %s\nautor: %s\nano de publicacao: %d\n %s\n ISBN:%s\n=========================================\n ",
                   acervo[i].titulo, acervo[i].autor, acervo[i].ano, acervo[i].disponivel == 1 ? "disponivel" : "indisponivel", acervo[i].isbn);

            contador++;
        }
